# --- secrets ---
.env
.env.local
*.pem
*.key

# --- data & outputs (용량 큼, 재생성 가능) ---
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
# outputs 아래는 전부 재생성 가능 — .gitkeep 만 남긴다.
# (하위 폴더만 막으면 outputs/ 바로 아래 파일이 새어 들어간다 — train_bundle.zip 사고)
outputs/*
!outputs/*/
outputs/*/*
!outputs/**/.gitkeep
*.parquet
*.sqlite
*.db

# --- python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# --- macOS / editors ---
.DS_Store
.vscode/
.idea/
