# 키움증권 신규 REST API 자격증명 (템플릿)
# 이 파일을 .env 로 **복사**해서 실제 값을 채운다. (이름을 바꾸지 말고 복사할 것 —
# 이 템플릿 자체는 저장소에 남아 있어야 다른 사람이 어떤 키가 필요한지 안다.)
#     cp .env.example .env
# ⚠️ 이 파일에는 절대 실제 값을 적지 않는다 — 커밋되는 파일이다.

# mock = 모의투자, live = 실전투자.
# 이 프로젝트는 항상 mock 만 사용한다. live 는 src/utils/config.py 에서 차단되어 있다.
KIWOOM_ENV=mock

# 키움 OpenAPI 포털(openapi.kiwoom.com) → My Page → API 신청 에서 발급.
# ⚠️ 같은 화면의 IP 관리에서 접속 IP 를 등록해야 호출이 통과한다.
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=

# 모의투자 계좌번호 (paper trading 단계에서만 필요)
KIWOOM_ACCOUNT_NO=

# base URL 기본값은 src/utils/config.py 에 정의. 문서와 다르면 여기서 덮어쓴다.
# KIWOOM_BASE_URL_MOCK=https://mockapi.kiwoom.com

# 전역 레이트 리미트 (초당 요청 수). 문서상 제한보다 보수적으로 설정.
KIWOOM_RATE_LIMIT_PER_SEC=3
